# Copy this file to .env and fill it in. Never commit .env.

# Your Neon connection string. Leave empty to use embedded Postgres on this computer.
# When set, uploaded files are stored in the database too.
DATABASE_URL=

# Cloudinary's API environment variable, cloudinary://<key>:<secret>@<cloud_name>.
# When set, uploaded PDFs and photos are stored there (privately) instead.
CLOUDINARY_URL=

# Connections kept open per server process.
DB_POOL_MAX=10
